APP_ENV=development
APP_NAME="Shram Jagaran CMS"
APP_VERSION=0.1.0
FRONTEND_URL=http://localhost:3000

HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s

DATABASE_URL=postgres://user:password@your-neon-host.neon.tech/sjdb?sslmode=require&pool_max_conns=10
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=change-me-to-a-secure-32-plus-character-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=168h
JWT_ISSUER=shram-jagaran-cms

R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shram-jagaran
R2_PUBLIC_URL=

SENTRY_ENABLED=false
SENTRY_DSN=

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

CORS_ORIGINS=http://localhost:3000
