# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=Shram Jagaran CMS
APP_VERSION=0.1.0
FRONTEND_URL=http://localhost:3000

# ─── HTTP ────────────────────────────────────────────────────────────────────
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@localhost:5432/shramjagaran?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=168h
JWT_ISSUER=shram-jagaran-cms

# ─── SMTP ────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@shramjagaran.org
SMTP_FROM_NAME=Shram Jagaran

# ─── Cloudflare R2 ───────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shram-jagaran
R2_PUBLIC_URL=
R2_ENABLED=false

# ─── Sentry ──────────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENABLED=false

# ─── Rate Limit ──────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Admin (seeded on first run) ─────────────────────────────────────────────
ADMIN_EMAIL=admin@shramjagaran.np
ADMIN_PASSWORD=Admin@123
ADMIN_PHONE=+977-9800000001
ADMIN_FULL_NAME=Platform Admin
